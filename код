Вот готовый рабочий код для создания простого калькулятора на Kotlin.
Этот пример использует сетку кнопок, обрабатывает ввод цифр, базовых операций (+, -, *, /) и считает результат с помощью легкой библиотеки exp4j, которая умеет вычислять математические выражения из обычной строки.

0. Подготовка (Важный шаг)

Чтобы приложение могло вычислять выражения вроде 2+5*3, добавьте библиотеку exp4j в файл build.gradle.kts (модуля app):
kotlin
dependencies {
    // Добавьте эту строку в блок dependencies:
    implementation("net.objecthunter:exp4j:0.4.8")
}
Используйте код с осторожностью.
После добавления нажмите кнопку Sync Now вверху экрана Android Studio.

1. Интерфейс: res/layout/activity_main.xml

Замените содержимое вашего файла разметки следующим кодом. Здесь используется ConstraintLayout для экрана вывода и GridLayout для аккуратного размещения кнопок.
xml
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://android.com"
    xmlns:app="http://android.com"
    xmlns:tools="http://android.com"
    xmlns:app2="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#222222"
    tools:context=".MainActivity">

    <!-- Экран для отображения ввода и результата -->
    <TextView
        android:id="@+id/tvExpression"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:gravity="end"
        android:text=""
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        app2:layout_bottom_toTopOf="@id/tvResult"
        app2:layout_constraintEnd_toEndOf="match_parent"
        app2:layout_constraintStart_toStartOf="match_parent" />

    <TextView
        android:id="@+id/tvResult"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:gravity="end"
        android:text="0"
        android:textColor="#CCCCCC"
        android:textSize="24sp"
        app2:layout_bottom_toTopOf="@id/gridLayout"
        app2:layout_constraintEnd_toEndOf="match_parent"
        app2:layout_constraintStart_toStartOf="match_parent" />

    <!-- Сетка кнопок 4x5 -->
    <GridLayout
        android:id="@+id/gridLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="5"
        android:padding="8dp"
        app2:layout_constraintBottom_toBottomOf="match_parent">

        <!-- Строка 1 -->
        <Button android:id="@+id/btnC" android:text="C" style="@style/CalcButtonOp"/>
        <Button android:id="@+id/btnBracketOpen" android:text="(" style="@style/CalcButtonOp"/>
        <Button android:id="@+id/btnBracketClose" android:text=")" style="@style/CalcButtonOp"/>
        <Button android:id="@+id/btnDiv" android:text="/" style="@style/CalcButtonOp"/>

        <!-- Строка 2 -->
        <Button android:id="@+id/btn7" android:text="7" style="@style/CalcButtonNum"/>
        <Button android:id="@+id/btn8" android:text="8" style="@style/CalcButtonNum"/>
        <Button android:id="@+id/btn9" android:text="9" style="@style/CalcButtonNum"/>
        <Button android:id="@+id/btnMult" android:text="*" style="@style/CalcButtonOp"/>

        <!-- Строка 3 -->
        <Button android:id="@+id/btn4" android:text="4" style="@style/CalcButtonNum"/>
        <Button android:id="@+id/btn5" android:text="5" style="@style/CalcButtonNum"/>
        <Button android:id="@+id/btn6" android:text="6" style="@style/CalcButtonNum"/>
        <Button android:id="@+id/btnSub" android:text="-" style="@style/CalcButtonOp"/>

        <!-- Строка 4 -->
        <Button android:id="@+id/btn1" android:text="1" style="@style/CalcButtonNum"/>
        <Button android:id="@+id/btn2" android:text="2" style="@style/CalcButtonNum"/>
        <Button android:id="@+id/btn3" android:text="3" style="@style/CalcButtonNum"/>
        <Button android:id="@+id/btnAdd" android:text="+" style="@style/CalcButtonOp"/>

        <!-- Строка 5 -->
        <Button android:id="@+id/btn0" android:text="0" style="@style/CalcButtonNum" android:layout_columnSpan="2" android:layout_width="0dp" android:layout_gravity="fill_horizontal"/>
        <Button android:id="@+id/btnDot" android:text="." style="@style/CalcButtonNum"/>
        <Button android:id="@+id/btnEqual" android:text="=" style="@style/CalcButtonEqual"/>

    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
