2. Логика: MainActivity.kt

Замените код в вашем основном Kotlin-файле. Обратите внимание на имя пакета (package ...) в первой строке вашего проекта — оставьте его своим.
kotlin
package com.example.calculator // Укажите здесь имя ВАШЕГО пакета

import android.os.Bundle
import android.widget.Button
import android.widget.TextView
import androidx.appcompat.app.AppCompatActivity
import net.objecthunter.exp4j.ExpressionBuilder
import java.lang.Exception

class MainActivity : AppCompatActivity() {

    private lateinit var tvExpression: TextView
    private lateinit var tvResult: TextView

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_main)

        tvExpression = findViewById(R.id.tvExpression)
        tvResult = findViewById(R.id.tvResult)

        // Находим все кнопки цифр и точки
        val numButtons = listOf(
            R.id.btn0, R.id.btn1, R.id.btn2, R.id.btn3, R.id.btn4,
            R.id.btn5, R.id.btn6, R.id.btn7, R.id.btn8, R.id.btn9, R.id.btnDot
        )

        // Находим кнопки операций
        val opButtons = listOf(
            R.id.btnAdd, R.id.btnSub, R.id.btnMult, R.id.btnDiv,
            R.id.btnBracketOpen, R.id.btnBracketClose
        )

        // Назначаем клики для цифр (просто добавляем текст на экран)
        for (id in numButtons) {
            findViewById<Button>(id).setOnClickListener {
                appendExpression((it as Button).text.toString())
            }
        }

        // Назначаем клики для операций
        for (id in opButtons) {
            findViewById<Button>(id).setOnClickListener {
                appendExpression((it as Button).text.toString())
            }
        }

        // Кнопка очистки (С)
        findViewById<Button>(R.id.btnC).setOnClickListener {
            tvExpression.text = ""
            tvResult.text = "0"
        }

        // Кнопка равенства (=)
        findViewById<Button>(R.id.btnEqual).setOnClickListener {
            calculateResult()
        }
    }

    // Метод добавления символов в строку выражения
    private fun appendExpression(string: String) {
        // Если в результате уже была ошибка, очищаем перед новым вводом
        if (tvResult.text == "Ошибка") {
            tvExpression.text = ""
            tvResult.text = ""
        }
        tvExpression.append(string)
    }

    // Метод подсчета результата с помощью библиотеки exp4j
    private fun calculateResult() {
        try {
            val expressionStr = tvExpression.text.toString()
            if (expressionStr.isEmpty()) return

            // Создаем выражение и вычисляем его
            val expression = ExpressionBuilder(expressionStr).build()
            val result = expression.evaluate()

            // Преобразуем результат в красивый вид (убираем .0 у целых чисел)
            val longResult = result.toLong()
            if (result == longResult.toDouble()) {
                tvResult.text = longResult.toString()
            } else {
                tvResult.text = result.toString()
            }

        } catch (e: Exception) {
            // Если выражение введено неверно (например, "5++2" или деление на ноль)
            tvResult.text = "Ошибка"
        }
    }
}
